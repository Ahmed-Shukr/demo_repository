<odoo>

    <record id="view_school_subject_tree" model="ir.ui.view">
        <field name="name">school.subject.tree</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="credit_hours"/>

            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_school_subject_form">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="school_color_picker"/>
                        </group>
                        <group>
                            <field name="credit_hours"/>
                            <field name="class_id"/>
                            <field name="academic_year_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_school_subject_search">
        <field name="name">school.subject.search</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="academic_year_id"/>
                <filter name="group_by_academic_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_subject" model="ir.actions.act_window">
        <field name="name">School Subject</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>