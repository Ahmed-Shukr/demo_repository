<odoo>

    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="academic_year_id"/>
                <field name="weekly_hours" widget="float_time"/>
                <field name="teacher_rating"/>
                <field name="class_id" widget="many2many_tags"/>
                <field name="tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_school_teacher_form">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="weekly_hours" widget="float_time"/>
                            <field name="teacher_rating"/>
                            <field name="class_id" widget="many2many_tags" domain="[('academic_year_id', '=', academic_year_id)] if academic_year_id else []"/>
                            <field name="tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <group string="Signature">
                        <field name="signature" widget="signature"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_school_teacher_search">
        <field name="name">school.teacher.search</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <filter name="group_by_rating" string="Teacher Rating" context="{'group_by': 'teacher_rating'}"/>
                <filter name="group_by_academic_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
