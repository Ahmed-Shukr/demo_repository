<odoo>

    <record id="view_school_class_tree" model="ir.ui.view">
        <field name="name">school.class.tree</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="class_description"/>

            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_school_class_form">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="academic_year_id"/>
                            <field name="department_id"/>
                            <field name="no_of_seats"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="tuition_fee"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students">
                            <!--                            <field name="student_ids"/>-->
                            <field name="student_ids" context="{'default_academic_year_id': academic_year_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="academic_year_id"/>
                                    <field name="class_id"/>
                                    <field name="gender"/>
                                </tree>

                            </field>
                        </page>
                        <page string="Description">
                            <group>
                                <field name="class_description"/>
                            </group>

                        </page>
                        <page string="Coding">
                            <field name="code" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_school_class_search">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="academic_year_id"/>
                <filter name="group_by_academic_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">School Class</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>